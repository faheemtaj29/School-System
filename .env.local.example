# Copy to .env.local and adjust.

# MongoDB connection string (local install or MongoDB Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/school-system

# Secret used to sign session JWTs. Use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional: external AI provider for the AI gateway (leave blank to use the built-in parser).
AI_PROVIDER_URL=
AI_PROVIDER_NAME=
AI_PROVIDER_KEY=
